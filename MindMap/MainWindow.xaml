<Window x:Class="MindMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MindMap.Views.Controls;assembly=MindMap.Views"
        xmlns:vm="clr-namespace:MindMap.ViewModels;assembly=MindMap.ViewModels"
        xmlns:core="clr-namespace:MindMap.Core.Services;assembly=MindMap.Core"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.InputBindings>
        <KeyBinding Key="Up"
                Command="{Binding NavigateCommand}"
                CommandParameter="{x:Static core:Direction.Up}" />
        <KeyBinding Key="Down"
                Command="{Binding NavigateCommand}"
                CommandParameter="{x:Static core:Direction.Down}" />
        <KeyBinding Key="Left"
                Command="{Binding NavigateCommand}"
                CommandParameter="{x:Static core:Direction.Left}" />
        <KeyBinding Key="Right"
                Command="{Binding NavigateCommand}"
                CommandParameter="{x:Static core:Direction.Right}" />
        <KeyBinding Key="Up"   Modifiers="Shift"
                Command="{Binding ExpandSelectionCommand}"
                CommandParameter="{x:Static core:Direction.Up}" />
        <KeyBinding Key="Down" Modifiers="Shift"
                Command="{Binding ExpandSelectionCommand}"
                CommandParameter="{x:Static core:Direction.Down}" />
    </Window.InputBindings>
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
		 <!--임시: StackPanel로 수직 배치--> 
		<ItemsControl ItemsSource="{Binding Roots}">
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="{x:Type vm:NodeVM}">
					<local:NodeView/>
					 <!--NodeView UserControl--> 
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</ScrollViewer>
